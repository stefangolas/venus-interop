// Venus's tip eject per channel pattern, to the default waste and back into the rack (STAR_OEM toolkit
// on pyhamilton's STAR_OEM_Test.lay): stage with stage_probe.py, then run_probe.py. Results in
// docs/FIRMWARE_EQUIVALENCE.md section 2.11.
namespace _Method { #include "HSLSeqLib.hsl" }
namespace _Method { #include "HSLTrcLib.hsl" }
namespace _Method { #include "STAR_OEM_toolkit.hs_" }
global device ML_STAR ("STAR_OEM_Test.lay", "ML_STAR", hslTrue);
namespace _Method {
// Venus's tip eject to the default waste, per channel pattern; then one eject back into the rack.
function eject(sequence & tips, variable start, variable pattern, variable toWaste) void
{
   variable ret;
   tips.SetCurrentPosition(start);
   STAR_OEM_TOOLKIT::Channels_1mL_TipPickUp(ML_STAR, tips, pattern, 0, 1, ret);
   tips.SetCurrentPosition(start);
   Trace("PROBE eject ", pattern, " toWaste ", toWaste);
   STAR_OEM_TOOLKIT::Channels_1mL_TipEject(ML_STAR, tips, pattern, 0, 1, toWaste, ret);
}
method main() void
{
   variable ret; variable i; sequence tips;
   for (i = 1; i <= 96; i++) SeqAdd(tips, "media_formulation_tips", IStr(i));
   STAR_OEM_TOOLKIT::Initialize(ML_STAR, 0, ret);
   eject(tips, 1, "10000000", 1);
   eject(tips, 9, "00010000", 1);
   eject(tips, 17, "00000001", 1);
   eject(tips, 25, "11000000", 1);
   eject(tips, 33, "11110000", 1);
   eject(tips, 41, "11111111", 1);
   eject(tips, 49, "10101010", 1);
   eject(tips, 57, "01000001", 1);
   eject(tips, 65, "11111111", 0);
}
}
