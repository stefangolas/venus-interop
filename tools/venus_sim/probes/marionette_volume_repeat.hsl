// Volume probe (venus-interop, 2026-10-22): one 440 uL aspirate and dispense repeated, then 431 uL,
// the volumes Marionette's media step draws; what Venus sends as av/dv each time
namespace _Method { method main(  ) void {
variable i;
COMMON96HEADSUBMETHODS::_InitLibrary();
LMSF_UTILITIES::_InitLibrary();
TIP_HANDLING_WITH_96_HEAD::_InitLibrary();
PLATEANDLIDMOVEMENT::_InitLibrary();
GSF_IMS_SHARED_SUBMETHODS::_InitLibrary();
LMSF_UTILITIES::InitSTARWithErrorEmail(ML_STAR, 1, 0);
GSF_IMS_SHARED_SUBMETHODS::tip_pickup(ML_STAR.Tips_1000_Channels, 4, ML_STAR);
i = 0;
while (i < 12) {
GSF_IMS_SHARED_SUBMETHODS::simple_aspirate(ML_STAR.Media_pipette_from_4, 0, 440, ML_STAR.Tips_1000_Channels, 4, ML_STAR);
GSF_IMS_SHARED_SUBMETHODS::simple_dispense(ML_STAR.Media_pipette_from_4, 0, 1, 440, 0, 0, 4, ML_STAR);
i = i + 1;
}
i = 0;
while (i < 8) {
GSF_IMS_SHARED_SUBMETHODS::simple_aspirate(ML_STAR.Media_pipette_from_4, 0, 431, ML_STAR.Tips_1000_Channels, 4, ML_STAR);
GSF_IMS_SHARED_SUBMETHODS::simple_dispense(ML_STAR.Media_pipette_from_4, 0, 1, 431, 0, 0, 4, ML_STAR);
i = i + 1;
}
GSF_IMS_SHARED_SUBMETHODS::tip_eject(4, ML_STAR);
} }
